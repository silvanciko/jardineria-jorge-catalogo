# Copia este archivo como referencia de qué variables configurar en
# Vercel → tu proyecto → Settings → Environment Variables.
# NO pongas valores reales acá ni subas un .env con datos reales a git.

# Generado con: node scripts/hash-password.js "tu-contraseña"
ADMIN_PASSWORD_HASH=

# Cualquier cadena larga y aleatoria (ej: genera una con
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
SESSION_SECRET=

# Estas dos las crea Vercel automáticamente al conectar el proyecto
# con un almacén de Vercel KV desde su panel — no las escribas a mano.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Esta la crea Vercel automáticamente al conectar un almacén de Vercel Blob.
# BLOB_READ_WRITE_TOKEN=
